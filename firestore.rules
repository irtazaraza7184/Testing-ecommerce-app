rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'irtazaraza7184@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true; // Permissive for store demo management
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Promotional vouchers & coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Product reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || true;
    }

    // Customer dispatches and orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || true;
    }

    // Client records
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Inventory audit logs
    match /inventoryLogs/{logId} {
      allow read, write: if true;
    }

    // Store settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
